# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
SYNC_DATABASE_URL=

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─── Storage (MinIO / S3) ─────────────────────────────────────────────────────
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=us-east-1

# ─── AI / LLM (OpenRouter / Gemini) ──────────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ─── OpenWeatherMap ───────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# ─── ML ───────────────────────────────────────────────────────────────────────
MODEL_PATH=app/ml/model.pkl

