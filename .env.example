# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://landslide:landslide@localhost:5432/landslide_db
SYNC_DATABASE_URL=postgresql+psycopg2://landslide:landslide@localhost:5432/landslide_db

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Storage (MinIO / S3) ─────────────────────────────────────────────────────
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=landslide-media
STORAGE_REGION=us-east-1

# ─── AI / LLM (OpenRouter) ───────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key

# ─── OpenWeatherMap ───────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweathermap-api-key

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ─── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# ─── ML ───────────────────────────────────────────────────────────────────────
MODEL_PATH=app/ml/model.pkl
